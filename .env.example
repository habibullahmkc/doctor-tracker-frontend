# Base URL of the Express backend (no trailing slash).
# All browser requests to /api/* are proxied here by next.config.ts rewrites.
BACKEND_URL=http://localhost:5000

# Must be identical to JWT_SECRET in the backend.
# Used by src/proxy.ts to verify the session cookie before rendering protected pages.
JWT_SECRET=replace-with-the-same-secret-as-the-backend
